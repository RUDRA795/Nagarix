generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model CivicIssue {
  id             String          @id @default(cuid())
  ticketId       String          @unique
  category       String
  subCategory    String?
  title          String
  description    String
  imageUrl       String?
  latitude       Float?
  longitude      Float?
  wardNumber     Int?
  wardName       String?
  zone           String?
  locality       String?
  severity       String
  priority       Int             @default(3)
  status         String          @default("Reported")
  department     String?
  assignedTo     String?
  reportedBy     String?
  contactPhone   String?
  aiAnalysis     String?
  visionResult   String?
  resolutionNote String?
  resolvedAt     DateTime?
  slaDeadline    DateTime?
  slaBreach      Boolean         @default(false)
  source         String          @default("citizen")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  timeline       IssueTimeline[]
}

model IssueTimeline {
  id        String     @id @default(cuid())
  issueId   String
  status    String
  note      String?
  actor     String?
  createdAt DateTime   @default(now())
  issue     CivicIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(cuid())
  sessionId String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  metadata       String?
  createdAt      DateTime     @default(now())
}

model Ward {
  id         String  @id @default(cuid())
  wardNumber Int     @unique
  wardName   String
  zone       String
  population Int?
  areaSqKm   Float?
}
